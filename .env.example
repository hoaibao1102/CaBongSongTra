# Domain thật sau khi deploy, không kèm dấu / cuối
NEXT_PUBLIC_SITE_URL=https://example.vercel.app
# Số Zalo thật theo cú pháp 84xxxxxxxxx (không có +, không có số 0 đầu)
NEXT_PUBLIC_ZALO_PHONE=
# Tùy chọn: Google Analytics Measurement ID, ví dụ G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Supabase P0a (publishable/anon key an toàn cho browser khi RLS đúng)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; không bao giờ đổi thành NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
