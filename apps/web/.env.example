API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
WEB_ORIGIN=https://shop.example.com
# Required server-only secret, identical on API and web; provision >=32 random characters.
# Never use NEXT_PUBLIC_ or commit a real value.
BFF_SHARED_SECRET=

# Cloudinary CDN Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
